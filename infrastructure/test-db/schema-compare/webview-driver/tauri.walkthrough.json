{
  "identifier": "codes.imran.dbunk.plan022gate",
  "build": {
    "beforeDevCommand": "pnpm vite dev --port 3000 --config infrastructure/test-db/schema-compare/webview-driver/vite.config.ts"
  },
  "app": {
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "walkthrough-window",
          "description": "Walkthrough only: lets the driver keep the fixture window visible and resize it.",
          "windows": ["main"],
          "permissions": [
            "core:window:allow-show",
            "core:window:allow-minimize",
            "core:window:allow-unminimize",
            "core:window:allow-set-focus",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-size",
            "core:window:allow-set-min-size",
            "core:window:allow-set-position"
          ]
        }
      ]
    }
  }
}
