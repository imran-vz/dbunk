[
  {
    "name": "native-format",
    "command": [
      "cargo",
      "+1.98.1",
      "fmt",
      "--manifest-path",
      "apps/native/Cargo.toml",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "native-clippy",
    "command": [
      "cargo",
      "+1.98.1",
      "clippy",
      "--manifest-path",
      "apps/native/Cargo.toml",
      "--locked",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "native-harness-clippy",
    "command": [
      "cargo",
      "+1.98.1",
      "clippy",
      "--manifest-path",
      "apps/native/Cargo.toml",
      "--locked",
      "--features",
      "fixture-verification",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "native-test",
    "command": [
      "cargo",
      "+1.98.1",
      "test",
      "--manifest-path",
      "apps/native/Cargo.toml",
      "--locked"
    ],
    "exit": 101
  }
]
