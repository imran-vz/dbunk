{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agent",
    ".agents",
    ".claude",
    ".codex",
    ".continue",
    ".cursor",
    ".fallow",
    ".gemini",
    ".opencode",
    ".pi",
    ".roo",
    ".windsurf",
    "dist",
    "src-tauri",
    "node_modules",
    ".output",
    ".tanstack",
    "tools/oxlint/anti-slop",
    "src/routeTree.gen.ts"
  ]
}
