      "--manifest-path",
      "apps/native/Cargo.toml",
      "--locked",
      "apply_flow",
      "--",
      "--test-threads=1"
    ],
    "exit": 0
  },
  {
    "name": "persistence::tests",
    "command": [
      "cargo",
      "+1.98.1",
      "test",
      "--manifest-path",
      "apps/native/Cargo.toml",
      "--locked",
