{
  "name": "dbunk",
  "private": true,
  "version": "0.1.0-alpha.1",
  "description": "Open-source desktop database workspace for exploring data, running SQL, and inspecting schemas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imran-vz/dbunk.git"
  },
  "bugs": {
    "url": "https://github.com/imran-vz/dbunk/issues"
  },
  "homepage": "https://github.com/imran-vz/dbunk#readme",
  "keywords": [
    "database",
    "sql",
    "tauri",
    "react",
    "postgres",
    "mysql",
    "sqlite",
    "clickhouse"
  ],
  "type": "module",
  "scripts": {
    "dev:vite": "vite dev --port 3000",
    "db:all": "infrastructure/test-db/bin/test-db.sh all",
    "db:clickhouse": "infrastructure/test-db/bin/test-db.sh clickhouse",
    "db:down": "infrastructure/test-db/bin/test-db.sh down",
    "db:postgres": "infrastructure/test-db/bin/test-db.sh postgres",
    "db:postgres-redis": "infrastructure/test-db/bin/test-db.sh postgres-redis",
    "db:redis": "infrastructure/test-db/bin/test-db.sh redis",
    "build:vite": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "format": "biome format",
    "lint": "biome check",
    "fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "check:slice-isolation": "! grep -rE 'from \"\\./(connections|workspace-tabs|credentials|relational-tables|relational-queries|keyvalue-workspace|keyvalue-pubsub)\"' src/lib/store/connections.ts src/lib/store/workspace-tabs.ts src/lib/store/credentials.ts src/lib/store/relational-tables.ts src/lib/store/relational-queries.ts src/lib/store/keyvalue-workspace.ts src/lib/store/keyvalue-pubsub.ts",
    "generate:redis-commands": "node scripts/generate-redis-commands.mjs",
    "check:redis-commands": "node scripts/generate-redis-commands.mjs --check",
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-devtools": "^0.7.11",
    "@tanstack/react-form": "^1.32.0",
    "@tanstack/react-router": "^1.169.2",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-start": "^1.167.65",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/router-plugin": "^1.167.35",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dagre": "^0.8.5",
    "html-to-image": "^1.11.13",
    "nitro": "npm:nitro-nightly@3.0.1-20251230-165713-6e801e22",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reactflow": "^11.11.4",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.7",
    "sql-formatter": "^15.7.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^5.1.4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tanstack/devtools-vite": "^0.3.12",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.4",
    "web-vitals": "^5.2.0"
  },
  "packageManager": "pnpm@11.4.0"
}
