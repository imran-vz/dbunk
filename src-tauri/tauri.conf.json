{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dbunk",
  "version": "0.1.0",
  "identifier": "codes.imran.dbunk",
  "build": {
    "beforeDevCommand": "bun run --bun dev:vite",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run --bun build:vite",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "dbunk",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
